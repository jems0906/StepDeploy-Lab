# StepDeploy Lab Environment Configuration
# Copy this file to .env and adjust values as needed

# Service Ports
IDP_PORT=8001
CA_PORT=8002
ENROLLMENT_AGENT_PORT=8003
PROTECTED_SERVICE_PORT=8004
DIAGNOSTICS_API_PORT=8080
FRONTEND_PORT=5173

# Service URLs
IDP_URL=http://localhost:8001
CA_URL=http://localhost:8002
ENROLLMENT_AGENT_URL=http://localhost:8003
PROTECTED_SERVICE_URL=https://localhost:8004
DIAGNOSTICS_URL=http://localhost:8080

# Logging
LOG_LEVEL=INFO

# Persistence (diagnostics-api). Leave unset to disable and stay in-memory only.
TRACE_STORE_PATH=data/traces.json
INCIDENT_STORE_PATH=data/incidents.json
# Options: DEBUG, INFO, WARN, ERROR

# OAuth Configuration
OAUTH_TOKEN_TTL=3600
OAUTH_AUDIENCE=ca-service

# Certificate Configuration
CA_ROOT_VALIDITY_DAYS=3650
CA_INTERMEDIATE_VALIDITY_DAYS=1825
CLIENT_CERT_VALIDITY_DAYS=1

# Docker
DOCKER_REGISTRY=localhost
DOCKER_REGISTRY_USER=
DOCKER_REGISTRY_PASSWORD=

# AWS (for Terraform deployment)
AWS_REGION=us-east-1
AWS_PROFILE=default
TF_VAR_aws_region=us-east-1
TF_VAR_environment=dev
TF_VAR_ecs_desired_count=2

# Railway Deployment
RAILWAY_TOKEN=
RAILWAY_PROJECT_ID=

# Frontend Configuration
VITE_API_URL=http://localhost:8080

# Development
DEBUG=false
VERBOSE=false
